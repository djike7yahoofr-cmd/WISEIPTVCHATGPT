<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/splash_background"
    android:orientation="horizontal"
    android:padding="48dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingEnd="32dp">
        <ImageView android:layout_width="92dp" android:layout_height="92dp"
            android:src="@mipmap/ic_launcher" android:contentDescription="Wise IPTV" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="14dp" android:text="Mon compte"
            android:textColor="@color/white" android:textSize="30sp" android:textStyle="bold" />
        <TextView android:id="@+id/tv_tv_profile_login"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="18dp" android:textColor="@color/white" android:textSize="20sp" />
        <TextView android:id="@+id/tv_tv_profile_key"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:fontFamily="monospace"
            android:textColor="@color/wise_blue_light" android:textSize="15sp" />
        <TextView android:id="@+id/tv_tv_profile_subscription"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:background="@drawable/panel_background"
            android:padding="16dp" android:textColor="@color/white" android:textSize="16sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="32dp">
        <LinearLayout android:id="@+id/tv_expiry_alert"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@drawable/alert_background" android:orientation="vertical"
            android:padding="16dp" android:visibility="gone">
            <TextView android:id="@+id/tv_tv_expiry_message"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="@color/white" android:textSize="16sp" android:textStyle="bold" />
            <Button android:id="@+id/btn_tv_renew"
                android:layout_width="match_parent" android:layout_height="52dp"
                android:layout_marginTop="12dp" android:backgroundTint="@color/wise_red"
                android:text="Renouveler via WhatsApp" android:textColor="@color/white" />
        </LinearLayout>
        <Button android:id="@+id/btn_tv_profile_about"
            android:layout_width="match_parent" android:layout_height="56dp"
            android:layout_marginTop="12dp" android:text="À propos de WiseIPTV"
            android:backgroundTint="@color/wise_surface" />
        <Button android:id="@+id/btn_tv_profile_site"
            android:layout_width="match_parent" android:layout_height="56dp"
            android:layout_marginTop="8dp" android:text="Site officiel"
            android:textColor="@color/wise_blue_light" android:backgroundTint="@color/wise_surface" />
        <Button android:id="@+id/btn_tv_profile_back"
            android:layout_width="match_parent" android:layout_height="56dp"
            android:layout_marginTop="8dp" android:text="Retour aux chaînes" />
    </LinearLayout>
</LinearLayout>